# Runtime variables consumed by this repo.

# Proxmox / OpenTofu
# Format: user@realm!token_id=secret
PROXMOX_VE_API_TOKEN=

# OpenTofu S3 backend
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-1
AWS_DEFAULT_REGION=us-west-1
AWS_EC2_METADATA_DISABLED=true

# Kubernetes secrets
CLOUDFLARE_TUNNEL_TOKEN=
PROTONVPN_WIREGUARD_PRIVATE_KEY=
QBITTORRENT_WEBUI_USERNAME=
QBITTORRENT_WEBUI_PASSWORD=

# Reference/import-only values from homelab-secrets.
# These are not read by the current scripts unless listed above.
ARGOCD_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN_HOMEPAGE=
JELLYFIN_KEY=
JELLYSEERR_KEY=
LONGHORN_PASSWORD=
PROWLARR_KEY=
QBIT_PASSWORD=
RADARR_KEY=
SONARR_KEY=
